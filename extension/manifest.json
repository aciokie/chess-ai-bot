{
  "manifest_version": 3,
  "name": "Chess AI Bot",
  "version": "11.6.1",
  "description": "Real-time Stockfish analysis on Chess.com with auto-move, eval bar, and opening book",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://unpkg.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/play/*",
        "https://www.chess.com/game/*",
        "https://www.chess.com/analysis*",
        "https://www.chess.com/puzzles/*",
        "https://www.chess.com/daily*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Chess AI Bot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/stockfish-18-single.wasm", "lib/stockfish-18-single.js"],
      "matches": ["https://www.chess.com/*"]
    }
  ]
}